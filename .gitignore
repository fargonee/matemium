# =============================================================================
# Matemium .gitignore
#
# Monorepo with separate publish targets:
#   - Engine (Python)          : pip / PyPI / local `pip install -e .` / Docker (root)
#   - Website (React SPA)      : GitHub Pages (only website/ is built & deployed)
#   - Server (FastAPI)         : Northflank / PaaS (server/Dockerfile, context=server/)
#   - Desktop (Tauri)          : per-platform bundles (PyInstaller sidecar + Tauri build)
#
# Build artifacts from one target must never leak into another.
# =============================================================================

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.aider-runtime/
.uv-cache/

# Python packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Modern python packaging caches / envs
.hatch/
__pypackages__/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# ----------------------------
# Manim outputs
# ----------------------------
media/
videos/
images/
Tex/
tex/
text/
partial_movie_files/
*.mp4
*.mov
*.webm
*.gif

# Manim cache / generated files
.manim/
manim.cfg.backup
*.log
*.aux
*.dvi
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz

# ----------------------------
# Render / export outputs
# ----------------------------
renders/
exports/
output/
outputs/
out/
frames/
thumbnails/
screenshots/

# Generated assets (output visuals)
# Broad ignores here catch stray generated files.
# Source assets (app icons, website assets, design docs) are explicitly kept.
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# Re-include source / committed assets
!assets/**/*.png
!assets/**/*.jpg
!assets/**/*.jpeg
!assets/**/*.svg
!assets/**/*.pdf
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.svg
!docs/**/*.pdf
!docs/public/screenshots/
!docs/public/screenshots/**/*.png
!desktop/src-tauri/icons/**/*.png
!desktop/src-tauri/icons/**/*.jpg
!desktop/src-tauri/icons/**/*.svg
!desktop/src-tauri/icons/**/*.ico
!desktop/src-tauri/icons/**/*.icns
!website/public/**/*.png
!website/public/**/*.jpg
!website/public/**/*.svg
!website/public/**/*.ico
!website/public/**/*.icns
!website/public/media/
!website/public/media/**/*.mp4
!desktop/app/public/
!desktop/app/public/showcase/
!desktop/app/public/showcase/**/*.jpg
!desktop/app/public/showcase/**/*.mp4
!desktop/app/public/showcase/**/*.webm
!public/**/*.png
!public/**/*.jpg
!public/**/*.svg

# ----------------------------
# Project-specific generated data
# ----------------------------
cache/
caches/
tmp/
temp/
.temp/
.cache/

# Scene render checkpoints / scratch
scratch/
drafts/
sandbox/
playground/

# ----------------------------
# Jupyter / notebooks
# ----------------------------
.ipynb_checkpoints/

# ----------------------------
# Node / frontend (covers all subprojects)
# ----------------------------
node_modules/
.vite/

# ----------------------------
# Desktop (Tauri + Vite app) — covered by more specific rules below
# (binaries are regenerated; target is huge)
# ----------------------------

# ----------------------------
# Website (GitHub Pages publish only)
# ----------------------------
website/dist/

# ----------------------------
# Server (separate publish)
# ----------------------------
server/.venv/
server/dist/
server/.env

# ----------------------------
# Desktop / PyInstaller publish artifacts (regenerated per build)
# ----------------------------
desktop/src-tauri/binaries/matemium-sidecar*
desktop/src-tauri/target/

# Root-level PyInstaller / packaging output
dist/matemium-sidecar
dist/matemium-sidecar.exe
build/

# ----------------------------
# IDE / editor files
# ----------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.tsbuildinfo

# ----------------------------
# Environment / secrets
# ----------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ----------------------------
# Logs
# ----------------------------
logs/
*.log

# ----------------------------
# Dependency lock files
# ----------------------------
# Uncomment if you do NOT want to commit lock files.
# Usually keep these committed for reproducible projects.
# poetry.lock
# uv.lock
# Pipfile.lock
# requirements.lock

# ----------------------------
# OS files
# ----------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Trashes
ehthumbs.db
Desktop.ini
.aider*
