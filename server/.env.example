# Matemium Cloud Server
MATEMIUM_ENV=production
# PaaS platforms (Northflank, Railway, etc.) inject PORT. We also support MATEMIUM_PORT.
# HOST / PORT without prefix also work.
MATEMIUM_HOST=0.0.0.0
MATEMIUM_PORT=8080
PORT=8080

# Dev desktop login stub (disable in production)
MATEMIUM_AUTH_STUB=true

# Supabase — shared auth for website + desktop
MATEMIUM_SUPABASE_URL=https://your-project.supabase.co
MATEMIUM_SUPABASE_ANON_KEY=your-anon-key
MATEMIUM_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MATEMIUM_ADMIN_EMAILS=you@company.com

# Lemon Squeezy billing
# Full instructions: ../LEMON_SQUEEZY_SETUP.md
# Dashboard → Settings → API → Create API key
MATEMIUM_LEMON_SQUEEZY_API_KEY=
# Dashboard → Settings → Webhooks → Signing secret (after registering webhook)
MATEMIUM_LEMON_SQUEEZY_WEBHOOK_SECRET=
# Store ID and Variant ID from your Pro subscription product
MATEMIUM_LEMON_SQUEEZY_STORE_ID=
MATEMIUM_LEMON_SQUEEZY_VARIANT_PRO_MONTHLY=
# Set false in production
MATEMIUM_LEMON_SQUEEZY_TEST_MODE=true
MATEMIUM_SITE_URL=http://localhost:5173
# Webhook URL you will register in Lemon: https://<server>/v1/webhooks/lemonsqueezy
# Subscribe to at minimum: order_created, order_refunded, all subscription_* and subscription_payment_* events (see LEMON_SQUEEZY_SETUP.md)

# CORS — website SPA + Tauri dev origins
# Add your Cloudflare Pages origin(s) + your server/PaaS URL when deploying:
# e.g. https://matemium-website.pages.dev,https://matemium-xxx.northflank.app
# Previews: https://*.matemium-website.pages.dev (use pattern or specific preview URLs)
MATEMIUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,tauri://localhost,http://localhost,http://127.0.0.1

# LLM provider (OpenAI-compatible)
MATEMIUM_LLM_API_BASE=https://api.openai.com/v1
MATEMIUM_LLM_API_KEY=
MATEMIUM_LLM_MODEL=gpt-4o-mini
MATEMIUM_LLM_STUB=true

# Rate limits (requests per minute) - production values recommended
MATEMIUM_RATE_LIMIT_FREE_RPM=12
MATEMIUM_RATE_LIMIT_PRO_RPM=120