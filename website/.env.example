# Supabase — browser sign-in (Google OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=http://localhost:5173
# For GitHub Pages:
#   VITE_SITE_URL=https://<user>.github.io
#   (or https://<user>.github.io/<repo-name> for project sites)

# FastAPI cloud bridge (Northflank / your PaaS URL)
VITE_API_URL=http://127.0.0.1:8080
# Example: https://matemium-server-abc123.northflank.app

# Comma-separated bootstrap admin emails (optional)
VITE_ADMIN_EMAILS=you@company.com

# For GitHub Pages sub-directory hosting (project pages, not user/org root):
# VITE_BASE=/your-repo-name/
# Leave unset (or /) for root deployment (user/org pages or custom domain)