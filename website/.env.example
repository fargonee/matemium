# Supabase — browser sign-in (Google OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=http://localhost:5173
# For Cloudflare Pages (production):
#   VITE_SITE_URL=https://your-project.pages.dev
# For previews Cloudflare will provide per-PR URLs; VITE_SITE_URL can be left for runtime fallback in lib/env.ts

# FastAPI cloud bridge (Northflank / your PaaS URL)
VITE_API_URL=http://127.0.0.1:8080
# Example: https://matemium-server-abc123.northflank.app
# (Billing endpoints + Lemon Squeezy checkout/portal are served from here)

# Comma-separated bootstrap admin emails (optional)
VITE_ADMIN_EMAILS=you@company.com

# Base public path. Leave unset or "/" for normal Cloudflare Pages root deployment.
# Only set VITE_BASE=/some-subpath/ if you serve the site under a sub-directory.
VITE_BASE=