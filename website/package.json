    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.0.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
